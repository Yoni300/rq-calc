{
  "name": "rq-calc",
  "version": "1.0.26",
  "description": "Royal Quest character stat calculator",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "export-data": "node tools/export-data.mjs && node tools/update-stamps-wiki.mjs --offline && node tools/patch-data.mjs",
    "test": "node test/smoke.js",
    "dist": "electron-builder --win",
    "update-stamps": "node tools/update-stamps-wiki.mjs",
    "predist": "node tools/write-version.mjs",
    "release": "node tools/release.mjs"
  },
  "devDependencies": {
    "electron": "^45.2.0",
    "electron-builder": "^26.18.0"
  },
  "productName": "RQ Calc",
  "author": "Yoni300",
  "build": {
    "appId": "com.yoni300.rqcalc",
    "productName": "RQ Calc",
    "files": [
      "main.js",
      "preload.js",
      "ocr/**",
      "card-match.js",
      "card-scan.js",
      "stats/**",
      "trade/**",
      "build/icon.png",
      "app/**",
      "src/**",
      "data/**",
      "package.json",
      "server/**",
      "!node_modules/tesseract.js-core/tesseract-core-lstm.{js,wasm,wasm.js}",
      "!node_modules/tesseract.js-core/tesseract-core-simd-lstm.{js,wasm,wasm.js}",
      "!node_modules/tesseract.js-core/tesseract-core-relaxedsimd-lstm.{js,wasm,wasm.js}",
      "!node_modules/tesseract.js/dist/**",
      "!node_modules/@techstark/opencv-js/dist/src/**",
      "!test/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "RQ-Calc-Setup-${version}.exe",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RQ Calc",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Yoni300",
        "repo": "rq-calc",
        "releaseType": "release"
      }
    ],
    "asarUnpack": [
      "ocr/**",
      "stats/ocr/**",
      "trade/assets/**",
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/bmp-js/**",
      "node_modules/idb-keyval/**",
      "node_modules/is-url/**",
      "node_modules/node-fetch/**",
      "node_modules/whatwg-url/**",
      "node_modules/tr46/**",
      "node_modules/webidl-conversions/**",
      "node_modules/regenerator-runtime/**",
      "node_modules/wasm-feature-detect/**",
      "node_modules/zlibjs/**"
    ]
  },
  "dependencies": {
    "@techstark/opencv-js": "4.12.0-release.1",
    "electron-updater": "^6.8.11",
    "tesseract.js": "7.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Yoni300/rq-calc.git"
  }
}
